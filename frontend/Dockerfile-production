FROM node:24.21.0-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS build-stage
WORKDIR /app
RUN npm install --global npm@12.1.0 && test "$(node --version)" = v24.21.0 && test "$(npm --version)" = 12.1.0
COPY package*.json ./
COPY scripts/patch-declarations.ts scripts/patch-declarations.ts
RUN npm ci
COPY . .
ARG PKDB_BUILD_COMMIT
ENV PKDB_BUILD_COMMIT=${PKDB_BUILD_COMMIT}
RUN npm run typecheck && npm run build

# Static server for compose.production.yaml; the configuration is mounted from nginx/pkdb.conf.
FROM nginx:1.29.1-alpine@sha256:42a516af16b852e33b7682d5ef8acbd5d13fe08fecadc7ed98605ba5e3b26ab8 AS web
COPY --from=build-stage /app/dist /usr/share/nginx/html

# Artifact-only handoff (default target): the deployment's static server consumes /vue.
FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8 AS production-stage
COPY --from=build-stage /app/dist /vue
CMD ["tail", "-f", "/dev/null"]
