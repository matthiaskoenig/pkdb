FROM node:24.21.0-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS build-stage
WORKDIR /app
RUN npm install --global npm@12.1.0 && test "$(node --version)" = v24.21.0 && test "$(npm --version)" = 12.1.0
COPY package*.json ./
COPY scripts/patch-declarations.ts scripts/patch-declarations.ts
RUN npm ci
COPY . .
RUN npm run typecheck && npm run build

# Artifact-only handoff: the deployment's static server consumes /vue.
FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8 AS production-stage
COPY --from=build-stage /app/dist /vue
CMD ["tail", "-f", "/dev/null"]
