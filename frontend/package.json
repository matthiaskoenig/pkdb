{
  "name": "pkdb-frontend",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.x",
    "npm": "12.1.x"
  },
  "packageManager": "npm@12.1.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "serve": "npm run dev",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "bash ../tools/frontend_testing/run.sh",
    "test:source": "node scripts/check-source.ts",
    "postinstall": "node scripts/patch-declarations.ts"
  },
  "dependencies": {
    "vue": "3.5.43",
    "vuetify": "4.2.1",
    "vue-router": "5.3.1",
    "pinia": "4.0.3",
    "axios": "1.20.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "plotly.js-dist-min": "4.1.1"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "@vitejs/plugin-vue": "6.0.9",
    "vite-plugin-vuetify": "2.1.3",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/compiler-dom": "3.5.43",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.11",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "eslint-plugin-vue": "10.11.0",
    "vue-eslint-parser": "10.4.1",
    "typescript-eslint": "8.70.1",
    "jiti": "2.7.0",
    "vitest": "5.0.1",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "sass": "1.105.0"
  }
}
