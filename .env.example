# Optional Docker Compose overrides. Defaults work without this file.
# Copy to .env to customize the local stack.
PKDB_HTTP_PORT=18083
PKDB_PYTHON_VERSION=3.14
# Use a URL-safe value, because it is embedded in the database connection URL.
PKDB_POSTGRES_PASSWORD=local-development-only
PKDB_CORS_ORIGINS=[]
PKDB_BROWSER_ORIGIN=http://localhost:8080
PKDB_SECURE_COOKIES=false
# Production: use an HTTPS origin and secure cookies.
PKDB_SMTP_HOST=
PKDB_SMTP_SENDER=
PKDB_SMTP_PORT=587
PKDB_SMTP_USERNAME=
PKDB_SMTP_PASSWORD=
PKDB_SMTP_STARTTLS=true
